<script>
function calc(){
var f=+document.getElementById('f').value||0,fl=+document.getElementById('fl').value||0,s=+document.getElementById('s').value||0,a=+document.getElementById('a').value||0,i=+document.getElementById('i').value||0;
var cif=f+fl+s,ar=cif*a/100,it=(cif+ar)*i/100,t=ar+it;
var n=function(x){return x.toLocaleString('es-DO',{minimumFractionDigits:2,maximumFractionDigits:2})};
document.getElementById('r').innerHTML='<tr><th>Concepto</th><th>USD</th></tr><tr><td>Valor CIF</td><td>'+n(cif)+'</td></tr><tr><td>Arancel</td><td>'+n(ar)+'</td></tr><tr><td>ITBIS</td><td>'+n(it)+'</td></tr><tr><td><strong>Total tributos</strong></td><td><strong>'+n(t)+'</strong></td></tr>';
}
calc();
</script>
